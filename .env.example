# Copy to .env for local development. Do NOT commit your filled-in .env.
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:4000/api

# SMTP — set these before testing actual submissions (admin delivery required).
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-me
SMTP_PASS=replace-me
MAIL_FROM="Rozgar Links <no-reply@example.invalid>"
ADMIN_EMAIL=admin@example.invalid
SEND_APPLICANT_CONFIRMATION=false
SMTP_CONNECTION_TIMEOUT_MS=10000

# DEMO bank details only. Replace after legal review and approval.
BANK_ACCOUNT_TITLE=Rozgar Links Services
BANK_NAME=Sample Bank Ltd
BANK_ACCOUNT_NUMBER=0000-1234567890
BANK_IBAN=PK00SAMP0000001234567890
SERVICE_FEE_AMOUNT=5000
SERVICE_FEE_CURRENCY=PKR
PAYMENT_DETAILS_ARE_DEMO=true
RECRUITMENT_LICENSE_NUMBER=PENDING-VERIFICATION

ENABLE_SCRAPING=false
STATS_CRON="5 0 * * *"
APP_TIME_ZONE=Asia/Karachi
MAX_FILE_MB=5
APPLICATION_RATE_LIMIT_MAX=5
TRUST_PROXY_HOPS=0
# Optional extension; do not enable without matching server implementation.
# TURNSTILE_SECRET_KEY=
# VITE_TURNSTILE_SITE_KEY=
